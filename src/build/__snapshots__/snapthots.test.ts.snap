exports[`shapshots workspaceLandings theme should match pseudo theme from CssVars 1`] = `
{
  "animationDurationL": "var(--vkui--animation_duration_l, 0.4s)",
  "animationDurationM": "var(--vkui--animation_duration_m, 0.2s)",
  "animationDurationS": "var(--vkui--animation_duration_s, 0.1s)",
  "animationEasingDefault": "var(--vkui--animation_easing_default, cubic-bezier(0.3, 0.3, 0.5, 1))",
  "animationEasingPlatform": "var(--vkui--animation_easing_platform, cubic-bezier(0.3, 0.3, 0.5, 1))",
  "blurM": "var(--vkui--blur_m, 16px)",
  "breakpoints": {
    "desktopS": {
      "adaptiveValue": "compact",
      "breakpoint": 768,
    },
    "touch": {
      "adaptiveValue": "regular",
      "breakpoint": 0,
    },
  },
  "colorAccentAzure": {
    "active": "var(--vkui--color_accent_azure--active, #1482FF)",
    "hover": "var(--vkui--color_accent_azure--hover, #0A7CFF)",
    "normal": "var(--vkui--color_accent_azure, #0077FF)",
  },
  "colorAccentBlue": {
    "active": "var(--vkui--color_accent_blue--active, #1482FF)",
    "hover": "var(--vkui--color_accent_blue--hover, #0A7CFF)",
    "normal": "var(--vkui--color_accent_blue, #0077ff)",
  },
  "colorAccentCyan": {
    "active": "var(--vkui--color_accent_cyan--active, #1BE7F9)",
    "hover": "var(--vkui--color_accent_cyan--hover, #11E6F9)",
    "normal": "var(--vkui--color_accent_cyan, #07E5F9)",
  },
