exports[`shapshots vkontakteCom theme should match pseudo theme from CssVars 1`] = `
{
  "animationDurationL": "var(--vkui--animation_duration_l, 0.4s)",
  "animationDurationM": "var(--vkui--animation_duration_m, 0.2s)",
  "animationDurationS": "var(--vkui--animation_duration_s, 0.1s)",
  "animationEasingDefault": "var(--vkui--animation_easing_default, cubic-bezier(0.3, 0.3, 0.5, 1))",
  "animationEasingPlatform": "var(--vkui--animation_easing_platform, cubic-bezier(0.4, 0, 0.2, 1))",
  "blurM": "var(--vkui--blur_m, 16px)",
  "colorAccentAzure": {
    "active": "var(--vkui--color_accent_azure--active, #3A80D3)",
    "hover": "var(--vkui--color_accent_azure--hover, #3C85D9)",
    "normal": "var(--vkui--color_accent_azure, #3F8AE0)",
  },
  "colorAccentBlue": {
    "active": "var(--vkui--color_accent_blue--active, #4B78AE)",
    "hover": "var(--vkui--color_accent_blue--hover, #4E7CB3)",
    "normal": "var(--vkui--color_accent_blue, #5181B8)",
  },
  "colorAccentCyan": {
    "active": "var(--vkui--color_accent_cyan--active, #72E2CF)",
    "hover": "var(--vkui--color_accent_cyan--hover, #77EBD6)",
    "normal": "var(--vkui--color_accent_cyan, #7CF4DC)",
  },
  "colorAccentGray": {
    "active": "var(--vkui--color_accent_gray--active, #A0AAB7)",
    "hover": "var(--vkui--color_accent_gray--hover, #A7B0BD)",
    "normal": "var(--vkui--color_accent_gray, #AEB7C2)",
  },
  "colorAccentGreen": {
    "active": "var(--vkui--color_accent_green--active, #45A64A)",
    "hover": "var(--vkui--color_accent_green--hover, #48AC4A)",
    "normal": "var(--vkui--color_accent_green, #4BB34B)",
